@startuml
!include _style.iuml
rectangle "Kaggle" as K
rectangle "Researcher" as R
usecase "1.0\nPreprocess\nand split" as P1
usecase "2.0\nTrain\nmodels" as P2
usecase "3.0\nEvaluate" as P3
usecase "4.0\nReport" as P4
database "D1 Raw data" as D1
database "D2 Splits" as D2
database "D3 Weights" as D3
database "D4 Results" as D4
K --> D1 : csv files
D1 --> P1 : clicks, orders
R --> P1 : profile, fractions
P1 --> D2 : train / valid / test
D2 --> P2 : sequences, baskets
P2 --> D3 : best weights
D3 --> P3 : model
D2 --> P3 : test targets
P3 --> D4 : metrics, per-user scores
D4 --> P4 : results
P4 --> R : tables, figures, PDF
@enduml
