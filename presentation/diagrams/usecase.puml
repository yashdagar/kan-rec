@startuml
!include _style.iuml
left to right direction
actor "Researcher\n(student)" as R
actor "Mentor /\nEvaluator" as M
actor "Kaggle" as K
actor "Compute host\n(Mac / UPES GPU / Colab)" as H
rectangle "KAN-Rec experiment system" {
  usecase "Select compute profile" as U1
  usecase "Download datasets" as U2
  usecase "Preprocess and split data" as U3
  usecase "Train a model variant" as U4
  usecase "Resume an interrupted run" as U5
  usecase "Evaluate on test set" as U6
  usecase "Run significance tests" as U7
  usecase "Generate tables and figures" as U8
  usecase "Inspect learned KAN functions" as U9
  usecase "Read report and results" as U10
}
R --> U1
R --> U2
R --> U4
R --> U8
R --> U9
M --> U10
U2 --> K
U4 --> H
U2 ..> U3 : <<include>>
U4 ..> U6 : <<include>>
U5 ..> U4 : <<extend>>
U8 ..> U7 : <<include>>
U10 ..> U8 : <<include>>
@enduml
